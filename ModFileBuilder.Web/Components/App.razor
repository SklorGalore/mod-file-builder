<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        if (new URLSearchParams(location.search).get('desktop') === '1') {
            document.documentElement.dataset.desktop = 'true';
        }
        try {
            const savedTheme = localStorage.getItem('mod-file-builder-theme');
            if (savedTheme === 'dark' || (savedTheme === null && matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.dataset.theme = 'dark';
            }
        } catch { }
    </script>
    <ResourcePreloader />
    <link href="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.bundle.scp.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["builder.css"]" />
    <link rel="stylesheet" href="@Assets["ModFileBuilder.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body class="case-builder">
    <Routes />
    <ReconnectModal />
    <script src="@Assets["download.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
